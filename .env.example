# ============================================
# ODOS Environment Variables Template
# Copy to .env and fill in real values
# NEVER commit .env to version control
# ============================================

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_PREFIX=odos

# --- Supabase Auth ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=odos-documents
R2_PUBLIC_URL=https://your-bucket.r2.dev

# --- Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key

# --- Service Ports ---
API_GATEWAY_PORT=4000
USER_SERVICE_PORT=4001
LEARNING_SERVICE_PORT=4002
ROADMAP_SERVICE_PORT=4003
SCHEDULER_SERVICE_PORT=4004
AI_SERVICE_PORT=4005
RESOURCE_SERVICE_PORT=4006

# --- Service URLs ---
USER_SERVICE_URL=http://localhost:4001
LEARNING_SERVICE_URL=http://localhost:4002
ROADMAP_SERVICE_URL=http://localhost:4003
SCHEDULER_SERVICE_URL=http://localhost:4004
AI_SERVICE_URL=http://localhost:4005
RESOURCE_DOCUMENT_SERVICE_URL=http://localhost:4006

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Security ---
ENCRYPTION_KEY=your-32-byte-hex-key-for-api-key-encryption
